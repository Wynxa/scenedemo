# Copy the required values into your shell environment before starting Flask.
# PowerShell example:
# $env:DATABASE_URL = 'mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/scene_behavior'

DATABASE_URL=mysql+pymysql://root@127.0.0.1:3306/scene_behavior
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-a-different-long-random-value

# CPU: 1. GPU deployment can raise this after load testing.
INFERENCE_WORKERS=1
INFERENCE_QUEUE_SIZE=8

# Use production when deploying behind a real WSGI server.
FLASK_ENV=development
